{
  "name": "live-notebook",
  "version": "0.4.2",
  "private": true,
  "description": "Live Notebook: a Claude Code Mod for capturing and searching useful conversation content.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "validate": "claude plugin validate .",
    "test": "claude plugin test .",
    "test:node": "node --test tests/node/note-format.test.mjs tests/node/server.test.mjs tests/node/store-lock.test.mjs",
    "web": "node web/server.mjs --launch",
    "web:stop": "node web/server.mjs --stop"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
