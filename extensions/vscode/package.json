{
  "name": "live-notebook",
  "displayName": "Live Notebook",
  "description": "Save AI coding replies and code as Markdown notes on your own computer, then search them. Works with Copilot, Cursor and Claude Code chats via selection or clipboard.",
  "version": "0.1.0",
  "publisher": "amberwjl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmberWJL/live-claude-notebook"
  },
  "homepage": "https://github.com/AmberWJL/live-claude-notebook#readme",
  "bugs": {
    "url": "https://github.com/AmberWJL/live-claude-notebook/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "notes",
    "markdown",
    "ai",
    "chat",
    "copilot",
    "cursor",
    "claude",
    "knowledge base",
    "local-first",
    "mcp"
  ],
  "main": "./extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "liveNotebook.saveSelection",
        "title": "Save Selection as Note",
        "category": "Live Notebook"
      },
      {
        "command": "liveNotebook.saveClipboard",
        "title": "Save Clipboard as Note",
        "category": "Live Notebook"
      },
      {
        "command": "liveNotebook.search",
        "title": "Search Notes",
        "category": "Live Notebook"
      },
      {
        "command": "liveNotebook.open",
        "title": "Open Notebook",
        "category": "Live Notebook"
      },
      {
        "command": "liveNotebook.showFolder",
        "title": "Show Notes Folder",
        "category": "Live Notebook"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "liveNotebook.saveSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ]
    },
    "configuration": {
      "title": "Live Notebook",
      "properties": {
        "liveNotebook.notesFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where the notes live. Empty: `LIVE_NOTEBOOK_HOME` if set, else `~/.claude/live-notebook`, the folder Live Notebook for Claude Code uses too."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "test": "node scripts/bundle.mjs && node test/run.mjs",
    "package": "node scripts/bundle.mjs && npx @vscode/vsce package --no-dependencies"
  }
}
